{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user profile information and game statistics",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "description": "User's profile picture URL" },
        "coins": { "type": "integer", "description": "User's total coins" },
        "wins": { "type": "integer", "description": "User's total wins" },
        "dailyBonusLastClaimed": { "type": "string", "format": "date-time", "description": "Last time daily bonus was claimed" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    }
  }
}
